# Lychee link-checker exclusions
# https://github.com/lycheeverse/lychee

# GitHub edit/view links generated by the Material theme (not real doc targets)
^https://github\.com/tiffany3222900/knowledge-management-system/(raw|edit)/.*

# Local preview links (serve.bat) - not reachable from CI runner
^http://127\.0\.0\.1:8000/.*
